<data1001 crlf="headers">
HTTP/1.1 401 NTLM challenge
Content-Length: 0
WWW-Authenticate: NTLM TlRMTVNTUAACAAAAAAAAAAAAAAABAggAESIzRFVmd4g=

</data1001>
<data1002 crlf="headers">
HTTP/1.1 200 OK
Content-Length: 2

OK
</data1002>
</reply>

<client>
<features>
NTLM
!SSPI
</features>
<server>
http
</server>
<name>
